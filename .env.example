# ── Base de datos PostgreSQL (Neon, Supabase, Railway o local) ───────────────
# Obligatoria: sin ella la aplicación no arranca.
DATABASE_URL=postgresql://usuario:contraseña@host:5432/catalogo?sslmode=require

# ── Sesiones del panel de administración ────────────────────────────────────
# Obligatorio en producción. Mínimo 16 caracteres y distinto de cualquier
# texto que ya exista en internet: con este valor se firman las cookies
# admin_session. Si falta, /api/auth/login responderá 503.
JWT_SECRET=cambia-este-texto-por-uno-largo-y-aleatorio-de-al-menos-16-caracteres

# ── Contraseña inicial del admin ────────────────────────────────────────────
# Solo se usa la primera vez: después se guarda encriptada (bcrypt) en la
# tabla admin_settings y se cambia desde el panel (🔐 Seguridad).
ADMIN_PASSWORD=TuContraseñaSegura123
